# ==============================================================================
# KnowledgeHub — Backend Apache Configuration (.htaccess)
# ==============================================================================

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Pass Authorization header through to PHP
    RewriteCond %{HTTP:Authorization} ^(.*)
    RewriteRule .* - [e=HTTP_AUTHORIZATION:%1]

    # If request path starts with /api/, serve it directly (no rewrite needed)
    RewriteCond %{REQUEST_URI} ^/api/ [NC]
    RewriteRule ^ - [L]

    # If request path is a bare route without /api/ prefix, add it
    RewriteCond %{REQUEST_URI} ^/(auth|categories|contents|admin|translate)/ [NC]
    RewriteRule ^(.*)$ /api/$1 [L,QSA]
</IfModule>

<IfModule mod_setenvif.c>
    SetEnvIf Authorization "(.*)" HTTP_AUTHORIZATION=$1
</IfModule>

# Prevent direct access to sensitive configuration files
<FilesMatch "(\.env|database\.php|\.sql)$">
    Order allow,deny
    Deny from all
</FilesMatch>
