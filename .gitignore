# ============================================================
# KnowledgeHub — Root .gitignore
# ============================================================

# --- Node / Frontend ---
node_modules/
frontend/node_modules/
/.pnp
.pnp.js
frontend/dist/
frontend/dist-ssr/
*.local

# --- Build artefacts ---
dist/
dist-ssr/
build/

# --- Logs ---
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# --- Environment & Secrets (NEVER commit these) ---
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
backend/.env
frontend/.env
frontend/.env.local
frontend/.env.production.local
*.pem
*.key
*.p12

# --- PHP / Backend ---
# Uploaded user files — ignore actual files but keep .gitkeep + .htaccess
backend/storage/*.pdf
backend/storage/*.docx
backend/storage/*.epub
backend/storage/*.mp4
backend/storage/sms_sent_log.log

# Email / sent logs folder contents
backend/storage/sent_emails/*
!backend/storage/sent_emails/.gitkeep

# PHP composer vendor (if ever used)
backend/vendor/

# --- Database ---
# Local SQL dumps with real data
*.sql
database/backups/

# --- Editor / IDE / OS ---
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store
Thumbs.db
desktop.ini
*~

# --- Test / temp ---
*.tmp
*.bak
*.orig
coverage/
